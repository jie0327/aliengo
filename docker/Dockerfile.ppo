# Standalone CPU-only training layer; the verified local torch runtime is mounted
# read-only at /torchsite at runtime and is deliberately not downloaded here.
FROM aliengo-learning:noetic
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/*
# Resolve MuJoCo/Gymnasium and their dependencies independently of torch so pip
# cannot replace the separately verified CPU torch with a CUDA build.
RUN python3 -m pip install --no-cache-dir \
    'numpy==1.24.4' 'mujoco==3.2.3' 'gymnasium==0.29.1' 'pandas==2.0.3' \
    && python3 -m pip install --no-cache-dir --no-deps 'stable-baselines3==2.3.2'
ENV CUDA_VISIBLE_DEVICES="" OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
