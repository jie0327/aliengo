@@ -0,0 +1,88 @@
+#if defined(COMPILE_WITH_SIMULATION) && defined(COMPILE_WITH_MOVE_BASE)
+#include "autonomy/GuideAutonomy.h"
+#include <sstream>
+#include <iomanip>
+namespace guide_autonomy {
+GuideAutonomy::GuideAutonomy() : node_("/aliengo/controller"), spinner_(1, &queue_) {
+    node_.setCallbackQueue(&queue_);
+    double timeout=.4, vx=.12, vy=.08, wz=.30;
+    node_.param("command_timeout", timeout, timeout);
+    node_.param("max_vx", vx, vx);
+    node_.param("max_vy", vy, vy);
+    node_.param("max_wz", wz, wz);
+    gate_ = CommandGate(timeout,vx,vy,wz);
+    subscriber_ = node_.subscribe("/exploration/cmd_vel", 1, &GuideAutonomy::command, this);
+    standService_ = node_.advertiseService("stand", &GuideAutonomy::stand, this);
+    autonomyService_ = node_.advertiseService("autonomy", &GuideAutonomy::autonomy, this);
+    publisher_ = node_.advertise<std_msgs::String>("status", 1, true);
+    timer_ = node_.createWallTimer(ros::WallDuration(.05), &GuideAutonomy::status, this);
+    spinner_.start();
+}
+GuideAutonomy::~GuideAutonomy() {
+    spinner_.stop();
+    std::lock_guard<std::mutex> lock(mutex_);
+    gate_.stop();
+}
+Velocity GuideAutonomy::sample() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return gate_.sample(ros::WallTime::now().toSec(),ros::Time::now().toSec());
+}
+Request GuideAutonomy::takeRequest(bool standReady) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return gate_.takeRequest(standReady);
+}
+void GuideAutonomy::transition(Mode mode) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    gate_.setMode(mode,ros::Time::now().toSec());
+    standReady_ = false;
+}
+void GuideAutonomy::feedback(bool standReady) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    standReady_ = standReady;
+}
+void GuideAutonomy::command(const geometry_msgs::TwistStamped::ConstPtr& msg) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Check all six components, even the three axes this gait does not command.
+    double vx=msg->twist.linear.x;
+    if (!std::isfinite(msg->twist.linear.z) || !std::isfinite(msg->twist.angular.x) ||
+        !std::isfinite(msg->twist.angular.y)) vx = NAN;
+    if (gate_.receive(vx,msg->twist.linear.y,msg->twist.angular.z,
+            msg->header.stamp.toSec(),ros::Time::now().toSec(),ros::WallTime::now().toSec(),msg->header.frame_id))
+        latestStamp_ = msg->header.stamp.toSec();
+}
+bool GuideAutonomy::stand(std_srvs::Trigger::Request&, std_srvs::Trigger::Response& response) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    gate_.request(Request::Stand);
+    standReady_ = false;
+    response.success = true;
+    response.message = "stand request queued; await status.stand_ready";
+    return true;
+}
+bool GuideAutonomy::autonomy(std_srvs::SetBool::Request& request, std_srvs::SetBool::Response& response) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    response.success = !request.data || (gate_.mode()==Mode::Stand && standReady_);
+    if (response.success) {
+        if (request.data) gate_.request(Request::Autonomy);
+        else gate_.cancelAutonomy();
+        standReady_ = false;
+    }
+    response.message = response.success ?
+        (request.data ? "mode request queued; await status.mode" : "autonomy cancelled; await status.mode") :
+        "completed stand required";
+    return true;
+}
+void GuideAutonomy::status(const ros::WallTimerEvent&) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Velocity velocity=gate_.sample(ros::WallTime::now().toSec(),ros::Time::now().toSec());
+    std::ostringstream json;
+    json << std::setprecision(16) << "{\"mode\":\"" << CommandGate::name(gate_.mode())
+         << "\",\"stand_ready\":" << (standReady_ ? "true" : "false")
+         << ",\"command_valid\":" << (gate_.valid() ? "true" : "false")
+         << ",\"command_reason\":\"" << gate_.reason() << "\",\"command_stamp\":" << latestStamp_
+         << ",\"vx\":" << velocity.vx << ",\"vy\":" << velocity.vy << ",\"wz\":" << velocity.wz << "}";
+    std_msgs::String message;
+    message.data=json.str();
+    publisher_.publish(message);
+}
+}
+#endif
