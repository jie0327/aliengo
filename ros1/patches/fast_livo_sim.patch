+void Preprocess::snapshot_handler(const sensor_msgs::PointCloud2::ConstPtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+  if (msg->width == 0 || msg->height == 0) return;
+  sensor_msgs::PointCloud2ConstIterator<float> x(*msg, "x"), y(*msg, "y"), z(*msg, "z");
+  size_t index = 0;
+  const size_t step = std::max(1, point_filter_num);
+  pl_surf.reserve(static_cast<size_t>(msg->width) * msg->height / step);
+  for (; x != x.end(); ++x, ++y, ++z, ++index)
+  {
+    if (index % step != 0 || !std::isfinite(*x) || !std::isfinite(*y) || !std::isfinite(*z)) continue;
+    if (double(*x) * *x + double(*y) * *y + double(*z) * *z < blind_sqr) continue;
+    PointType point{};
+    point.x = *x; point.y = *y; point.z = *z;
+    point.intensity = 0;
+    point.curvature = 0; // No fabricated scan duration or per-point acquisition offset.
+    pl_surf.push_back(point);
+  }
+}
