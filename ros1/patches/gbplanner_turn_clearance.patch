+template <typename SDFServerType, typename SDFVoxelType>
+VoxelStatus MapManagerVoxblox<SDFServerType, SDFVoxelType>::getSweptBoxStatus(
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end,
+    const Eigen::Vector3d& size, double yaw, bool stop_at_unknown_voxel) {
+  if (!start.allFinite() || !end.allFinite() || !size.allFinite() ||
+      !std::isfinite(yaw) || (size.array() < 0.).any()) return VoxelStatus::kUnknown;
+  const Eigen::Vector3d half = size / 2.;
+  const Eigen::Vector3d body_x(std::cos(yaw), std::sin(yaw), 0.);
+  const Eigen::Vector3d body_y(-std::sin(yaw), std::cos(yaw), 0.);
+  const Eigen::Vector3d extent = body_x.cwiseAbs()*half.x() + body_y.cwiseAbs()*half.y()
+                              + Eigen::Vector3d(0., 0., half.z());
+  const double resolution = getResolution();
+  const Eigen::Vector3d lower = start.cwiseMin(end) - extent;
+  const Eigen::Vector3d upper = start.cwiseMax(end) + extent;
+  const voxblox::LongIndex first = ((lower.array() - 1e-6) / resolution).floor().matrix().template cast<int64_t>();
+  const voxblox::LongIndex last = ((upper.array() + 1e-6) / resolution).floor().matrix().template cast<int64_t>();
+  const Eigen::Vector3d direction = end - start;
+  const Eigen::Vector3d axes[] = {Eigen::Vector3d::UnitX(), Eigen::Vector3d::UnitY(),
+                                Eigen::Vector3d::UnitZ(), body_x, body_y};
+  const double distance_thres = occupancy_distance_voxelsize_factor_ * resolution + 1e-6;
+  VoxelStatus result = VoxelStatus::kFree;
+  for (int64_t x = first.x(); x <= last.x(); ++x)
+    for (int64_t y = first.y(); y <= last.y(); ++y)
+      for (int64_t z = first.z(); z <= last.z(); ++z) {
+        const voxblox::LongIndex index(x, y, z);
+        const Eigen::Vector3d cell = (index.cast<double>().array() + .5).matrix() * resolution;
+        // Continuous separating-axis test: overlap intervals in translation
+        // time for the actual oriented body and voxel. Includes the interior,
+        // both end overhangs and stationary poses, without a clearance margin.
+        double enter = 0., leave = 1.;
+        bool intersects = true;
+        for (const auto& axis : axes) {
+          const double limit = std::abs(axis.dot(body_x))*half.x()
+              + std::abs(axis.dot(body_y))*half.y() + std::abs(axis.z())*half.z()
+              + .5*resolution*axis.cwiseAbs().sum() + 1e-6;
+          const double position = axis.dot(cell-start), velocity = axis.dot(direction);
+          if (std::abs(velocity) < 1e-12) {
+            if (std::abs(position) > limit) { intersects = false; break; }
+          } else {
+            double a = (position-limit)/velocity, b = (position+limit)/velocity;
+            if (a > b) std::swap(a, b);
+            enter = std::max(enter, a); leave = std::min(leave, b);
+            if (enter > leave) { intersects = false; break; }
+          }
+        }
+        if (!intersects) continue;
+        const auto* voxel = sdf_layer_->getVoxelPtrByGlobalIndex(index);
+        if (checkUnknownStatus(voxel)) {
+          if (stop_at_unknown_voxel) return VoxelStatus::kUnknown;
+          result = VoxelStatus::kUnknown;
+        } else if (voxel->distance <= distance_thres) return VoxelStatus::kOccupied;
+      }
+  return result;
+}
+
+template <typename SDFServerType, typename SDFVoxelType>
+VoxelStatus MapManagerVoxblox<SDFServerType, SDFVoxelType>::getPathStatusAtYaw(
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end, const Eigen::Vector3d& size,
+    double yaw, bool stop_at_unknown) {
+  if (!collision_geometry_fix_) return getPathStatus(start, end, size, stop_at_unknown);
+  if (!start.allFinite() || !end.allFinite() || !size.allFinite() ||
+      !std::isfinite(yaw) || (size.array() < 0.).any()) return VoxelStatus::kUnknown;
+  const auto status = getSweptBoxStatus(start, end, size, yaw, stop_at_unknown);
+  // Preserve each official method's relaxed unknown-space semantics: methods
+  // 1/2/3 skip unknown when requested; method 0 propagates its box result.
+  if (!stop_at_unknown && line_status_method_ != 0 && status == VoxelStatus::kUnknown)
+    return VoxelStatus::kFree;
+  return status;
+}
+
+template <typename SDFServerType, typename SDFVoxelType>
+VoxelStatus MapManagerVoxblox<SDFServerType, SDFVoxelType>::getRotatingBoxStatus(
+    const Eigen::Vector3d& center, const Eigen::Vector3d& size,
+    double from_yaw, double to_yaw, bool stop_at_unknown) {
+  if (!collision_geometry_fix_) return getBoxStatus(center, size, stop_at_unknown);
+  if (!std::isfinite(from_yaw) || !std::isfinite(to_yaw)) return VoxelStatus::kUnknown;
+  const double angle = std::atan2(std::sin(to_yaw-from_yaw), std::cos(to_yaw-from_yaw));
+  const int count = std::max(1, static_cast<int>(std::ceil(std::abs(angle)/(2.*M_PI/180.))));
+  const double step = angle/count;
+  // This is a bound on actual corner motion within each 2-degree interval,
+  // not a safety clearance: every intermediate orientation is enclosed.
+  const double motion = std::hypot(size.x(), size.y()) * std::sin(std::abs(step)/4.);
+  const Eigen::Vector3d interval_size = size + Eigen::Vector3d(2.*motion, 2.*motion, 0.);
+  VoxelStatus result = VoxelStatus::kFree;
+  for (int i = 0; i < count; ++i) {
+    auto status = getSweptBoxStatus(center, center, interval_size,
+                                   from_yaw+(i+.5)*step, stop_at_unknown);
+    if (status == VoxelStatus::kOccupied || (stop_at_unknown && status == VoxelStatus::kUnknown)) return status;
+    if (status == VoxelStatus::kUnknown) result = status;
+  }
+  return result;
+}
 
