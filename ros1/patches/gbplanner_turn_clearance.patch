+bool Rrg::isOutputPathCollisionFree(const std::vector<geometry_msgs::Pose>& path) {
+  if (path.empty()) return false;
+  double yaw = current_state_[3];
+  for (size_t i = 0; i < path.size(); ++i) {
+    const auto& a = path[i == 0 ? 0 : i-1].position;
+    const auto& b = path[i].position;
+    Eigen::Vector3d start(a.x, a.y, a.z), end(b.x, b.y, b.z);
+    const Eigen::Vector3d delta = end-start;
+    const double heading = delta.head(2).norm() > 1e-9 ? std::atan2(delta.y(), delta.x()) : yaw;
+    if (map_manager_->getRotatingBoxStatus(start + robot_params_.center_offset,
+            robot_box_size_, yaw, heading, true) != VoxelStatus::kFree) return false;
+    const Eigen::Vector3d overshoot = delta.norm() > 1e-9
+        ? Eigen::Vector3d(delta.normalized()*planning_params_.edge_overshoot)
+        : Eigen::Vector3d::Zero();
+    if (map_manager_->getPathStatusAtYaw(start + robot_params_.center_offset - overshoot,
+            end + robot_params_.center_offset + overshoot, robot_box_size_, heading, true)
+            != VoxelStatus::kFree) return false;
+    yaw = heading;
+  }
+  // The follower aligns to the terminal yaw, including a stationary turn.
+  const auto& last = path.back();
+  return map_manager_->getRotatingBoxStatus(
+      Eigen::Vector3d(last.position.x, last.position.y, last.position.z) + robot_params_.center_offset,
+      robot_box_size_, yaw, tf::getYaw(last.orientation), true) == VoxelStatus::kFree;
+}
