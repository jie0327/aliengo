+#ifndef REALSENSE_GAZEBO_D435_PROJECTION_H
+#define REALSENSE_GAZEBO_D435_PROJECTION_H
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <string>
+
+namespace gazebo {
+namespace d435 {
+
+using Point = std::array<double, 3>;
+
+inline const char *ImageEncoding(const std::string &format) {
+  if (format == "R8G8B8" || format == "RGB_INT8")
+    return "rgb8";
+  if (format == "L8" || format == "L_INT8")
+    return "8UC1";
+  return nullptr;
+}
+
+struct Pinhole {
+  unsigned int width, height;
+  double fx, fy, cx, cy;
+
+  static Pinhole FromImage(unsigned int width, unsigned int height, double hfov) {
+    const double focal = 0.5 * width / std::tan(0.5 * hfov);
+    return {width, height, focal, focal, 0.5 * width, 0.5 * height};
+  }
+};
+
+struct RigidTransform {
+  // Row-major rotation and translation from depth optical to color optical.
+  std::array<double, 9> rotation{{1, 0, 0, 0, 1, 0, 0, 0, 1}};
+  Point translation{{0, 0, 0}};
+};
+
+struct Pixel {
+  int u, v;
+};
+
+inline RigidTransform OpticalTransform(const RigidTransform &physical) {
+  // Columns are the optical x/right, y/down, z/forward axes in physical space.
+  const double basis[] = {0, 0, 1, -1, 0, 0, 0, -1, 0};
+  RigidTransform optical;
+  optical.rotation.fill(0);
+  optical.translation.fill(0);
+  for (unsigned int row = 0; row < 3; ++row) {
+    for (unsigned int i = 0; i < 3; ++i) {
+      optical.translation[row] += basis[3 * i + row] * physical.translation[i];
+      for (unsigned int column = 0; column < 3; ++column)
+        for (unsigned int j = 0; j < 3; ++j)
+          optical.rotation[3 * row + column] += basis[3 * i + row] *
+              physical.rotation[3 * i + j] * basis[3 * j + column];
+    }
+  }
+  return optical;
+}
+
+inline bool Unproject(const Pinhole &camera, unsigned int u, unsigned int v,
+                      double depth, Point &point) {
+  if (!std::isfinite(depth) || depth <= 0 || camera.fx <= 0 || camera.fy <= 0)
+    return false;
+  point = {{(u - camera.cx) * depth / camera.fx,
+            (v - camera.cy) * depth / camera.fy, depth}};
+  return true;
+}
+
+inline bool ProjectColor(const Pinhole &camera, const RigidTransform &transform,
+                         const Point &point, Pixel &pixel) {
+  Point color = transform.translation;
+  for (unsigned int row = 0; row < 3; ++row)
+    for (unsigned int column = 0; column < 3; ++column)
+      color[row] += transform.rotation[3 * row + column] * point[column];
+  if (!std::isfinite(color[0]) || !std::isfinite(color[1]) ||
+      !std::isfinite(color[2]) || color[2] <= 0)
+    return false;
+  const double u = camera.fx * color[0] / color[2] + camera.cx;
+  const double v = camera.fy * color[1] / color[2] + camera.cy;
+  if (!std::isfinite(u) || !std::isfinite(v) ||
+      u < 0 || v < 0 || u >= camera.width || v >= camera.height)
+    return false;
+  pixel = {static_cast<int>(std::lround(u)), static_cast<int>(std::lround(v))};
+  return pixel.u >= 0 && pixel.v >= 0 &&
+         static_cast<unsigned int>(pixel.u) < camera.width &&
+         static_cast<unsigned int>(pixel.v) < camera.height;
+}
+
+inline uint16_t DepthMillimeters(float depth, float minimum, float maximum) {
+  if (!std::isfinite(depth) || depth <= 0 || depth < minimum || depth > maximum ||
+      depth > 0.001 * std::numeric_limits<uint16_t>::max())
+    return 0;
+  return static_cast<uint16_t>(std::lround(depth * 1000.0));
+}
