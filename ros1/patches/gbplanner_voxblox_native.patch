diff -ruN a/voxblox_ros/include/voxblox_ros/native_cloud_queue.h b/voxblox_ros/include/voxblox_ros/native_cloud_queue.h
--- a/voxblox_ros/include/voxblox_ros/native_cloud_queue.h	1970-01-01 08:00:00.000000000 +0800
+++ b/voxblox_ros/include/voxblox_ros/native_cloud_queue.h	2026-11-14 09:11:18.509883091 +0800
@@ -0,0 +1,43 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <string>
+
+namespace voxblox {
+// Keep origins independent. Search all pending observations so delayed TF for
+// one origin (or timestamp) cannot starve another. Storage and dedup are bounded.
+template <typename Message> class NativeCloudQueue {
+  struct Entry { uint64_t stamp; Message message; };
+  std::map<std::string, std::deque<Entry>> pending_;
+  std::map<std::string, std::deque<uint64_t>> seen_;
+ public:
+  bool push(const std::string& frame, uint64_t stamp, const Message& message,
+            uint64_t minimum_interval = 0) {
+    if (frame.empty() || stamp == 0) return false;
+    auto& seen = seen_[frame];
+    for (auto other : seen) {
+      const auto delta = other > stamp ? other-stamp : stamp-other;
+      if (delta == 0 || delta < minimum_interval) return false;
+    }
+    seen.push_back(stamp);
+    if (seen.size() > 256) seen.pop_front();
+    auto& pending = pending_[frame];
+    pending.push_back({stamp, message});
+    if (pending.size() > 16) pending.pop_front();
+    return true;
+  }
+  template <typename Ready> bool popReady(Ready ready, Message* output) {
+    for (auto& source : pending_) {
+      for (auto it = source.second.begin(); it != source.second.end(); ++it) {
+        if (!ready(source.first, it->stamp, it->message)) continue;
+        *output = it->message;
+        source.second.erase(it);
+        return true;
+      }
+    }
+    return false;
+  }
+};
+}
