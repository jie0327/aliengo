<launch>
    <!-- The mount defaults are estimates and should be measured. -->
    <arg name="mid360_x" default="0.25"/>
    <arg name="mid360_y" default="0"/>
    <arg name="mid360_z" default="0.103"/>
    <arg name="mid360_roll" default="0"/>
    <arg name="mid360_pitch" default="0"/>
    <arg name="mid360_yaw" default="0"/>
    <arg name="mid360_downsample" default="4"/>
    <arg name="d435_enabled" default="true"/>
    <arg name="d435_x" default="0.32"/>
    <arg name="d435_y" default="0"/>
    <arg name="d435_z" default="-0.03"/>
    <arg name="d435_roll" default="0"/>
    <arg name="d435_pitch" default="0"/>
    <arg name="d435_yaw" default="0"/>
    <arg name="d435_depth_width" default="848"/>
    <arg name="d435_depth_height" default="480"/>
    <arg name="d435_color_width" default="1280"/>
    <arg name="d435_color_height" default="720"/>
    <arg name="d435_rate" default="30"/>
    <arg name="d435_depth_hfov" default="1.518436449"/>
    <arg name="d435_color_hfov" default="1.204277184"/>
    <arg name="d435_min_depth" default="0.2"/>
    <arg name="d435_max_depth" default="10"/>
    <arg name="d435_color_offset_y" default="0.015"/>
    <arg name="d435_stereo_baseline" default="0.05"/>
    <arg name="wname" default="earth"/>
    <arg name="world_file" default="$(find unitree_gazebo)/worlds/$(arg wname).world"/>
    <arg name="spawn_x" default="0"/>
    <arg name="spawn_y" default="0"/>
    <arg name="spawn_z" default="0.6"/>
    <arg name="spawn_yaw" default="0"/>
    <arg name="rviz" default="false"/>
    <arg name="sim_ground_truth_tf" default="true"/>
    <arg name="rname" default="go1"/>
    <arg name="robot_path" value="(find $(arg rname)_description)"/>
    <arg name="dollar" value="$"/>

    <arg name="paused" default="true"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="gui" default="true"/>
    <arg name="headless" default="false"/>
    <arg name="debug" default="false"/>
    <!-- Debug mode will hung up the robot, use "true" or "false" to switch it. -->
    <arg name="user_debug" default="false"/>
    
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_file)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
        <arg name="headless" value="$(arg headless)"/>
    </include>

    <!-- Load the URDF into the ROS Parameter Server -->
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '/course/ros1/mid360/robot.xacro'
           DEBUG:=$(arg user_debug) mid360_x:=$(arg mid360_x) mid360_y:=$(arg mid360_y) mid360_z:=$(arg mid360_z)
           mid360_roll:=$(arg mid360_roll) mid360_pitch:=$(arg mid360_pitch) mid360_yaw:=$(arg mid360_yaw) mid360_downsample:=$(arg mid360_downsample)
           d435_enabled:=$(arg d435_enabled) d435_x:=$(arg d435_x) d435_y:=$(arg d435_y) d435_z:=$(arg d435_z)
           d435_roll:=$(arg d435_roll) d435_pitch:=$(arg d435_pitch) d435_yaw:=$(arg d435_yaw)
           d435_depth_width:=$(arg d435_depth_width) d435_depth_height:=$(arg d435_depth_height)
           d435_color_width:=$(arg d435_color_width) d435_color_height:=$(arg d435_color_height)
           d435_rate:=$(arg d435_rate) d435_depth_hfov:=$(arg d435_depth_hfov) d435_color_hfov:=$(arg d435_color_hfov)
           d435_min_depth:=$(arg d435_min_depth) d435_max_depth:=$(arg d435_max_depth)
           d435_color_offset_y:=$(arg d435_color_offset_y) d435_stereo_baseline:=$(arg d435_stereo_baseline)"/>

    <!-- Convert Gazebo's legacy PointCloud to standard PointCloud2. -->
    <node pkg="aliengo_mid360" type="cloud_converter.py" name="mid360_cloud_converter" output="screen"/>
    <node pkg="aliengo_mid360" type="imu_converter.py" name="mid360_imu_converter" output="screen"/>
    <!-- Gazebo 真值只用于仿真显示/对照；估计器接管 TF 时应关闭此通路。 -->
    <group if="$(arg sim_ground_truth_tf)">
        <node unless="$(arg user_debug)" pkg="aliengo_mid360" type="gazebo_pose_tf.py"
              name="gazebo_ground_truth" output="screen">
            <param name="model_name" value="$(arg rname)_gazebo"/>
        </node>
    </group>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="mid360_rviz"
          launch-prefix="python3 /course/ros1/mid360/rviz_spawn_view.py $(arg spawn_x) $(arg spawn_y) $(arg spawn_z)"
          args="-d /course/ros1/mid360/pointcloud.rviz" output="screen">
        <env name="DISABLE_ROS1_EOL_WARNINGS" value="1"/>
    </node>

    <!-- Run a python script to the send a service call to gazebo_ros to spawn a URDF robot -->
    <!-- Set trunk and joint positions at startup -->
    <node pkg="gazebo_ros" type="spawn_model" name="urdf_spawner" respawn="false" output="screen"
          args="-urdf -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y $(arg spawn_yaw) -model $(arg rname)_gazebo -param robot_description -unpause"/>

    <!-- Load joint controller configurations from YAML file to parameter server -->
    <rosparam file="$(arg dollar)$(arg robot_path)/config/robot_control.yaml" command="load"/>

    <!-- load the controllers -->
    <node pkg="controller_manager" type="spawner" name="controller_spawner" respawn="false"
          output="screen" ns="/$(arg rname)_gazebo" args="--timeout 120 joint_state_controller
          FL_hip_controller FL_thigh_controller FL_calf_controller
          FR_hip_controller FR_thigh_controller FR_calf_controller
          RL_hip_controller RL_thigh_controller RL_calf_controller
          RR_hip_controller RR_thigh_controller RR_calf_controller "/>

    <!-- convert joint states to TF transforms for rviz, etc -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
          respawn="false" output="screen">
        <remap from="/joint_states" to="/$(arg rname)_gazebo/joint_states"/>
    </node>

    <!-- <node pkg="unitree_gazebo" type="servo" name="servo" required="true" output="screen"/> -->

    <!-- load the parameter unitree_controller -->
    <include file="$(find unitree_controller)/launch/set_ctrl.launch">
        <arg name="rname" value="$(arg rname)"/>
    </include>

</launch>
