Panels:
- Class: rviz/Displays
  Name: 显示
Preferences:
  PromptSaveOnExit: false
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: lio_map
    Frame Rate: 30
  Displays:
  - Class: rviz/Grid
    Name: 坐标参考网格（非地面）
    Enabled: true
    Value: true
    Alpha: 0.25
    Cell Size: 2
    Color: 110; 110; 120
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Offset:
      X: 0
      Y: 0
      Z: 0
  - Class: rviz/PointCloud2
    Name: Super-LIO配准点云（30秒累积）
    Enabled: true
    Value: true
    Topic: /lio/cloud_world
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds:
      Value: true
    Alpha: 1
    Decay Time: 30
    Queue Size: 2
    Style: Points
    Size (Pixels): 2
    Use Fixed Frame: true
    Use rainbow: true
  - Class: rviz/Image
    Name: D435 彩色图像
    Enabled: true
    Value: true
    Image Topic: /camera/color/image_raw
    Transport Hint: raw
    Queue Size: 2
    Normalize Range: false
  - Class: rviz/PointCloud2
    Name: D435 深度点云（高度着色）
    Enabled: true
    Value: true
    Topic: /camera/depth/color/points
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Alpha: 1
    Decay Time: 0
    Queue Size: 10
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Selectable: true
    Use Fixed Frame: true
    Axis: Z
  - Class: rviz/Path
    Name: Super-LIO估计轨迹
    Enabled: true
    Value: true
    Topic: /lio/path
    Alpha: 1
    Color: 40; 240; 100
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz/PointCloud2
    Name: 已观测地面
    Enabled: true
    Value: true
    Topic: /exploration/terrain_points
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Alpha: 0.7
    Queue Size: 2
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz/Path
    Name: GBPlanner 当前执行路径
    Enabled: true
    Value: true
    Topic: /exploration/path
    Color: 255; 150; 30
    Alpha: 1
    Line Style: Lines
    Line Width: 0.04
  - Class: rviz/Axes
    Name: 机身坐标轴
    Enabled: true
    Reference Frame: base
    Length: 0.3
    Radius: 0.01
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Name: 实机估计位姿与点云
      Target Frame: <Fixed Frame>
      Distance: 6
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1920
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
