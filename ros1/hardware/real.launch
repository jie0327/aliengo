<launch>
  <arg name="config" default="/hardware/runtime.yaml"/>
  <arg name="sensor_config" default="/hardware/planner_sensor.yaml"/>
  <arg name="map_dir"/>
  <!-- Super-LIO prefixes its compiled /lio/src/super_lio/ root, even for
       absolute paths. The host launcher supplies ../../../hardware/... . -->
  <param name="/use_sim_time" value="false"/>
  <rosparam file="$(arg config)" ns="aliengo_hardware" command="load"/>
  <rosparam file="$(find aliengo_super_lio)/sim_snapshot.yaml" command="load"/>
  <!-- Official real Livox path, not SIM_SNAPSHOT. Original filtering retained. -->
  <param name="/lio/sensor/lidar_type" value="1"/>
  <param name="/lio/ros/lidar_topic" value="/livox/lidar_custom"/>
  <!-- Keep fine obstacle returns; registration still uses its existing voxel. -->
  <param name="/lio/output/dense" value="true"/>
  <param name="/lio/map/save_map_dir" value="$(arg map_dir)"/>
  <param name="/lio/map/map_name" value="map.pcd"/>
  <node pkg="aliengo_hardware" type="hardware_tf.py" name="hardware_sensor_tf" output="screen" required="true"/>
  <node pkg="aliengo_hardware" type="livox_adapter.py" name="livox_real_adapter" output="screen" required="true"/>
  <node pkg="nodelet" type="nodelet" name="camera_depth_manager" args="manager" output="screen" required="true"/>
  <node pkg="nodelet" type="nodelet" name="camera_depth_points"
        args="load depth_image_proc/point_cloud_xyz camera_depth_manager" output="screen" required="true">
    <remap from="image_rect" to="/camera/depth/image_rect_raw"/>
    <remap from="camera_info" to="/camera/depth/camera_info"/>
    <remap from="points" to="/camera/depth/color/points"/>
  </node>
  <node pkg="super_lio" type="super_lio_node" name="super_lio_node" output="screen" required="true"/>
  <node pkg="aliengo_super_lio" type="lio_base_tf.py" name="lio_base_tf" output="screen" required="true"/>
  <node pkg="aliengo_exploration" type="mapping_node.py" name="exploration_mapping" output="screen" required="true"/>
  <include file="$(find aliengo_exploration)/planner.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
  </include>
  <node pkg="aliengo_exploration" type="coordinator.py" name="exploration_coordinator" output="screen" required="true">
    <param name="require_clock" value="false"/>
  </node>
</launch>
