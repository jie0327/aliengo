<launch>
  <arg name="rviz" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="map_dir" default="/fast_livo/maps/current"/>
  <param name="/use_sim_time" value="true"/>
  <group ns="fast_livo">
    <rosparam file="$(find aliengo_fast_livo)/sim_snapshot.yaml" command="load"/>
    <param name="pcd_save/output_dir" value="$(arg map_dir)"/>
    <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true"
          launch-prefix="$(find aliengo_fast_livo)/scripts/calibrated_exec.py">
      <remap from="/aft_mapped_to_init" to="/fast_livo/odom"/>
      <remap from="/cloud_registered" to="/fast_livo/cloud_world"/>
      <remap from="/path" to="/fast_livo/path"/>
      <remap from="/rgb_img" to="/fast_livo/tracked_image"/>
      <remap from="/cloud_visual_sub_map_before" to="/fast_livo/visual_submap"/>
      <remap from="/LIVO2/imu_propagate" to="/fast_livo/imu_propagate"/>
    </node>
    <node if="$(arg publish_tf)" pkg="aliengo_super_lio" type="lio_base_tf.py"
          name="base_tf" output="screen" required="true">
      <remap from="/lio/odom" to="/fast_livo/odom"/>
    </node>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find aliengo_fast_livo)/mapping.rviz" output="screen">
      <env name="DISABLE_ROS1_EOL_WARNINGS" value="1"/>
    </node>
  </group>
</launch>
